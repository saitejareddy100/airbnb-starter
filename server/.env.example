# MongoDB Connection URL
# Get this from: https://www.mongodb.com/cloud/atlas
MONGODB_URL="mongodb+srv://your_username:your_password@your_cluster.mongodb.net/?retryWrites=true&w=majority"

# JWT Secret for authentication
# Generate a strong secret: https://www.uuidgenerator.net/ or use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT="your_secret_jwt_key_here"
